{
    "name": "stylescape-example-svelte",
    "description": "Stylescape example with Svelte and Vite",
    "version": "0.0.2",
    "private": true,
    "type": "module",
    "repository": "https://github.com/stylescape/example-svelte",
    "license": "MIT",
    "engines": {
        "node": ">=22.0.0"
    },
    "stackblitz": {
        "startCommand": "npm run dev"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint:css": "stylelint \"src/**/*.{css,scss}\"",
        "format": "prettier --write \"src/**/*.{js,ts,jsx,tsx,css,scss,html,json}\"",
        "test": "npm run build"
    },
    "dependencies": {
        "stylescape": "^0.3.18"
    },
    "devDependencies": {
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "prettier": "^3.9.5",
        "sass": "^1.101.0",
        "stylelint": "^17.14.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "svelte": "^5.56.4",
        "vite": "^8.1.4"
    }
}
