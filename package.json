{
    "name": "stylescape-example-svelte",
    "description": "Stylescape example with Svelte and Vite",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "repository": "https://github.com/stylescape/example-svelte",
    "license": "MIT",
    "engines": {
        "node": ">=22.0.0"
    },
    "stackblitz": {
        "startCommand": "npm run dev"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint:css": "stylelint \"src/**/*.{css,scss}\"",
        "format": "prettier --write \"src/**/*.{js,ts,jsx,tsx,css,scss,html,json}\"",
        "test": "npm run build"
    },
    "dependencies": {
        "stylescape": "^0.3.9"
    },
    "devDependencies": {
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "prettier": "^3.8.1",
        "sass": "^1.97.3",
        "stylelint": "^16.26.1",
        "stylelint-config-standard-scss": "^15.0.1",
        "svelte": "^5.48.5",
        "vite": "^7.3.1"
    }
}
